{
  "id": "booster-unavailable-retried",
  "description": "A required booster that times out is the 529 booster_unavailable, retried as every 529 (2 retries, 3 attempts), then raised as an OverloadedError with error_type booster_unavailable and the boosters header parsed.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "",
      "images": [
        {
          "$image": {
            "id": "person",
            "url": "https://files.example.com/person.jpg"
          }
        }
      ],
      "questions": {
        "adult": {
          "$truth": {
            "instructions": "Is the person in the first picture an adult?"
          }
        }
      },
      "boosters": [
        {
          "$booster": {
            "name": "age",
            "require": true
          }
        }
      ]
    }
  },
  "mock": {
    "scenario": {
      "boosters": {
        "status": {
          "age": "timeout"
        }
      }
    }
  },
  "expect": {
    "attempts": 3,
    "outcome": {
      "error": "OverloadedError",
      "fields": {
        "status": 529,
        "error_type": "booster_unavailable",
        "message": "The booster 'age' did not answer in time.",
        "retry_after": 0.05,
        "boosters": {
          "age": {
            "status": "timeout",
            "latency_ms": 800
          }
        }
      }
    }
  }
}
