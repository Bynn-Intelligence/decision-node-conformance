{
  "id": "local-collections-enroll-url-refused",
  "description": "An enrollment's image URL is checked as a decision's: an https URL on a port other than 443 is refused locally with the API's 400 image_url_refused; nothing is sent.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "collections.enroll",
    "args": {
      "collection_id": "col_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80",
      "image": {
        "$image": {
          "id": "badge",
          "url": "https://files.example.com:8443/badges/emp-1042.jpg"
        }
      },
      "reference": "emp-1042"
    }
  },
  "expect": {
    "attempts": 0,
    "outcome": {
      "error": "BadRequestError",
      "fields": {
        "status": null,
        "error_type": "image_url_refused"
      }
    }
  }
}
