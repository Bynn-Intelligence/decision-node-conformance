{
  "id": "collections-enroll-face-model-unavailable-retried",
  "description": "An enrollment's 529 face_model_unavailable is retried as every 529, after its retry-after-ms, with the same Idempotency-Key: two attempts, then the item.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "mock": {
    "scenario": {
      "steps": [
        {
          "status": 529,
          "headers": {
            "content-type": "application/json",
            "retry-after": "1",
            "retry-after-ms": "20"
          },
          "body": {
            "detail": {
              "error_type": "overloaded_error",
              "message": "The face model is not available right now. Retry later.",
              "details": {
                "reason": "face_model_unavailable"
              }
            }
          }
        },
        {
          "status": 201,
          "headers": {
            "content-type": "application/json"
          },
          "body": {
            "id": "itm_9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d",
            "collection": "col_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80",
            "reference": "emp-1042",
            "label": "Reception",
            "metadata": {
              "department": "Reception",
              "badge_level": 2,
              "visitor": false
            },
            "faces_found": 1,
            "box": {
              "x1": 412,
              "y1": 220,
              "x2": 580,
              "y2": 470
            },
            "created_at": "2026-10-12T09:00:00Z",
            "usage": {
              "enrollments": 1,
              "cost": {
                "usd": 0.001
              }
            }
          }
        }
      ]
    }
  },
  "call": {
    "method": "collections.enroll",
    "args": {
      "collection_id": "col_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80",
      "image": {
        "$image": {
          "id": "badge",
          "url": "https://files.example.com/badges/emp-1042.jpg"
        }
      },
      "reference": "emp-1042"
    }
  },
  "expect": {
    "attempts": 2,
    "same_header": {
      "name": "idempotency-key",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "outcome": {
      "result": "item"
    }
  }
}
