{
  "id": "check-number-min-above-max",
  "description": "check_request on a decide request whose number grid has min above max raises what decide raises: ValidationError with the API's 422 entry. check_request runs the checks the call would run and sends nothing.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "s",
      "questions": {
        "n": {
          "$number": {
            "instructions": "How many?",
            "min": 60,
            "max": 50
          }
        }
      }
    },
    "check": true
  },
  "expect": {
    "attempts": 0,
    "outcome": {
      "error": "ValidationError",
      "fields": {
        "error_type": null,
        "entries": [
          {
            "type": "less_than_equal",
            "loc": [
              "body",
              "questions",
              "n",
              "number",
              "min"
            ],
            "msg": "Input should be less than or equal to 50",
            "input": 60,
            "ctx": {
              "le": 50
            }
          }
        ]
      }
    }
  }
}
