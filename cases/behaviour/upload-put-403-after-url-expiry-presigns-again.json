{
  "id": "upload-put-403-after-url-expiry-presigns-again",
  "description": "A PUT answered 403 after its URL's 5 minutes is presigned again, once. The harness gives the SDK the mock's clock (client.clock mock); the scenario moves that clock 301 s before the first PUT arrives, so the storage refuses the URL as expired (403 AccessDenied) and the SDK, by its own clock, sees the URL's expires_in (300 s) has passed: one new presign, one PUT, then the decision.",
  "client": {
    "api_key": "dn_test_conformance",
    "clock": "mock"
  },
  "mock": {
    "scenario": {
      "rules": [
        {
          "match": {
            "$method": "PUT"
          },
          "steps": [
            {
              "action": "normal",
              "advance_clock_seconds": 301
            }
          ]
        }
      ]
    }
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "s",
      "images": [
        {
          "$image": {
            "id": "a",
            "path": "fixtures/images/pixel.png",
            "pad_to": 600000
          }
        }
      ],
      "questions": {
        "q": {
          "$truth": {
            "instructions": "Does the receipt total equal the claim?"
          }
        }
      }
    }
  },
  "expect": {
    "attempts": 5,
    "request_sequence": [
      {
        "method": "POST",
        "path": "/v1/uploads",
        "status": 201
      },
      {
        "method": "PUT",
        "path_pattern": "^/_mock/s3/uploads/",
        "status": 403
      },
      {
        "method": "POST",
        "path": "/v1/uploads",
        "status": 201
      },
      {
        "method": "PUT",
        "path_pattern": "^/_mock/s3/uploads/",
        "status": 200
      },
      {
        "method": "POST",
        "path": "/v1/decide",
        "status": 200,
        "body_checks": [
          {
            "pointer": "/images/0/upload_id",
            "pattern": "^upl_[0-9a-f]{32}$"
          }
        ]
      }
    ],
    "outcome": {
      "result": "decision"
    }
  }
}
