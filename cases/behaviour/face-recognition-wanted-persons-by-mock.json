{
  "id": "face-recognition-wanted-persons-by-mock",
  "description": "face_recognition with wanted-persons, once the workspace may use it (the scenario's collections setting): a match carries its reference only, never a name.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "mock": {
    "scenario": {
      "collections": {
        "wanted_persons": true
      }
    }
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "",
      "images": [
        {
          "$image": {
            "id": "gate",
            "url": "https://files.example.com/gate-2/0917.jpg"
          }
        }
      ],
      "questions": {
        "someone_at_gate": {
          "$truth": {
            "instructions": "Is someone standing at the gate?"
          }
        }
      },
      "boosters": [
        {
          "$booster": {
            "name": "face_recognition",
            "options": {
              "collection": "wanted-persons"
            }
          }
        }
      ]
    }
  },
  "expect": {
    "attempts": 1,
    "outcome": {
      "result": "decision",
      "decision": {
        "evidence": {
          "face_recognition": {
            "version": "face_recognition-v1",
            "status": "ok",
            "latency_ms": 230,
            "billed_calls": 1,
            "results": [
              {
                "kind": "face_recognition",
                "image": "gate",
                "faces": 1,
                "matches": [
                  {
                    "box": {
                      "x1": 201,
                      "y1": 192,
                      "x2": 1715,
                      "y2": 715
                    },
                    "score": 0.7386,
                    "collection": "wanted-persons",
                    "reference": "missing:2024-67890",
                    "name": null,
                    "label": null
                  }
                ]
              }
            ]
          }
        }
      }
    }
  }
}
