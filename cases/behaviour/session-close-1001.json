{
  "id": "session-close-1001",
  "description": "The server holding the session is going away: after one reply the socket closes with 1001, reported as SessionClosed(1001) with reopen true (reopen on 1001, 1006, 1011, 4404, 4408, 4409, 4410).",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "mock": {
    "scenario": {
      "session": {
        "close": {
          "after_replies": 1,
          "code": 1001
        }
      }
    }
  },
  "steps": [
    {
      "call": {
        "method": "open_session",
        "args": {
          "state": {
            "mission": "Survey the north field"
          },
          "questions": {
            "mode": {
              "$choice": {
                "instructions": "Which flight mode now?",
                "options": {
                  "continue": "keep flying",
                  "hold": "hover",
                  "return": "fly home",
                  "land": "land now"
                }
              }
            },
            "abort": {
              "$truth": {
                "instructions": "Should the mission be aborted now?"
              }
            }
          }
        }
      },
      "save_as": "s"
    },
    {
      "connect": "s"
    },
    {
      "send": {
        "frame": "a",
        "session": "s"
      }
    },
    {
      "read": {
        "session": "s",
        "timeout_ms": 15000
      }
    }
  ],
  "expect": {
    "session_events": [
      {
        "reply": {
          "seq": 1
        }
      },
      {
        "closed": {
          "code": 1001,
          "reopen": true
        }
      }
    ]
  }
}
