{
  "id": "face-recognition-own-collection-by-mock",
  "description": "Against the mock: a face enrolled with metadata in the workspace's own collection Staff, then face_recognition with that collection; the result names the collection (collection_name), and its close match carries the collection, its name, the item's reference, its label and its metadata, as the API answers from 1.16's fields on. A collection's id in the mock follows from the workspace and the name.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "steps": [
    {
      "save_as": "col",
      "call": {
        "method": "collections.create",
        "args": {
          "name": "Staff"
        }
      }
    },
    {
      "call": {
        "method": "collections.enroll",
        "args": {
          "collection_id": {
            "$ref": "col.id"
          },
          "image": {
            "$image": {
              "id": "badge",
              "url": "https://files.example.com/badges/emp-1042.jpg"
            }
          },
          "reference": "emp-1042",
          "label": "Reception",
          "metadata": {
            "department": "Reception",
            "badge_level": 2
          }
        }
      }
    },
    {
      "call": {
        "method": "decide",
        "args": {
          "state": "",
          "images": [
            {
              "$image": {
                "id": "gate",
                "url": "https://files.example.com/gate-2/0917.jpg"
              }
            }
          ],
          "questions": {
            "someone_at_gate": {
              "$truth": {
                "instructions": "Is someone standing at the gate?"
              }
            }
          },
          "boosters": [
            {
              "$booster": {
                "name": "face_recognition",
                "options": {
                  "collection": {
                    "$ref": "col.id"
                  }
                }
              }
            }
          ]
        }
      },
      "outcome": {
        "result": "decision",
        "decision": {
          "evidence": {
            "face_recognition": {
              "version": "face_recognition-v1",
              "status": "ok",
              "latency_ms": 230,
              "billed_calls": 1,
              "results": [
                {
                  "kind": "face_recognition",
                  "image": "gate",
                  "faces": 1,
                  "collection_name": "Staff",
                  "matches": [
                    {
                      "box": {
                        "x1": 201,
                        "y1": 192,
                        "x2": 1715,
                        "y2": 715
                      },
                      "score": 0.7386,
                      "collection": "col_4da4fa2511b3c8fe3a620c8c948ea430",
                      "reference": "emp-1042",
                      "name": null,
                      "label": "Reception",
                      "collection_name": "Staff",
                      "metadata": {
                        "department": "Reception",
                        "badge_level": 2
                      }
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ],
  "expect": {
    "attempts": 3
  }
}
