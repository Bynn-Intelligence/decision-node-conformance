{
  "id": "session-end-404-is-success",
  "description": "end() on a session already ended: the DELETE gets 404, which end() treats as success.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "steps": [
    {
      "call": {
        "method": "open_session",
        "args": {
          "state": {
            "mission": "Survey the north field"
          },
          "questions": {
            "mode": {
              "$choice": {
                "instructions": "Which flight mode now?",
                "options": {
                  "continue": "keep flying",
                  "hold": "hover",
                  "return": "fly home",
                  "land": "land now"
                }
              }
            },
            "abort": {
              "$truth": {
                "instructions": "Should the mission be aborted now?"
              }
            }
          }
        }
      },
      "save_as": "s"
    },
    {
      "end": "s"
    },
    {
      "end": "s"
    }
  ],
  "expect": {
    "request_sequence": [
      {
        "method": "POST",
        "path": "/v1/sessions",
        "status": 200
      },
      {
        "method": "DELETE",
        "path_pattern": "^/v1/sessions/ses_[0-9a-f]{24}$",
        "status": 200
      },
      {
        "method": "DELETE",
        "path_pattern": "^/v1/sessions/ses_[0-9a-f]{24}$",
        "status": 404
      }
    ],
    "session_events": [
      {
        "ended": true
      },
      {
        "ended": true
      }
    ]
  }
}
