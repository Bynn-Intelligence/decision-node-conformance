{
  "id": "local-image-id-over-64-in-batch-create",
  "description": "A batch line with a 65-character image id is checked as a decide request: batches.create raises the API's 400 api_usage_error locally and nothing is sent.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "batches.create",
    "args": {
      "requests": [
        {
          "custom_id": "r1",
          "state": "",
          "images": [
            {
              "$image": {
                "id": "front",
                "url": "https://files.example.com/front.jpg"
              }
            },
            {
              "$image": {
                "id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                "url": "https://files.example.com/back.jpg"
              }
            }
          ],
          "questions": {
            "q": {
              "$truth": {
                "instructions": "Is this a receipt?"
              }
            }
          }
        }
      ]
    }
  },
  "expect": {
    "attempts": 0,
    "outcome": {
      "error": "BadRequestError",
      "fields": {
        "status": null,
        "error_type": "api_usage_error",
        "message": "Image 1: its id is longer than 64 characters.",
        "request_id": null
      }
    }
  }
}
