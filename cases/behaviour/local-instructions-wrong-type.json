{
  "id": "local-instructions-wrong-type",
  "description": "A truth question whose instructions are a number: instructions are a string, an object or an array, so the API's three 422 entries. Checked locally: the API's own error class is raised and no request reaches the mock.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "s",
      "questions": {
        "q": {
          "type": "truth",
          "instructions": 42
        }
      }
    }
  },
  "expect": {
    "attempts": 0,
    "outcome": {
      "error": "ValidationError",
      "fields": {
        "error_type": null,
        "entries": [
          {
            "type": "string_type",
            "loc": [
              "body",
              "questions",
              "q",
              "truth",
              "instructions",
              "str"
            ],
            "msg": "Input should be a valid string",
            "input": 42
          },
          {
            "type": "dict_type",
            "loc": [
              "body",
              "questions",
              "q",
              "truth",
              "instructions",
              "dict[any,any]"
            ],
            "msg": "Input should be a valid dictionary",
            "input": 42
          },
          {
            "type": "list_type",
            "loc": [
              "body",
              "questions",
              "q",
              "truth",
              "instructions",
              "list[any]"
            ],
            "msg": "Input should be a valid list",
            "input": 42
          }
        ]
      }
    }
  }
}
