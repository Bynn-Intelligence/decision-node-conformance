{
  "id": "session-frame-error-rate-limit-error",
  "description": "The input-token rate is used up: rate_limit_error with retry_after_ms. A FrameError value with its fields; the session continues.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "mock": {
    "scenario": {
      "session": {
        "frame_errors": {
          "1": {
            "error_type": "rate_limit_error",
            "retry_after_ms": 1000
          }
        }
      }
    }
  },
  "steps": [
    {
      "call": {
        "method": "open_session",
        "args": {
          "state": {
            "mission": "Survey the north field"
          },
          "questions": {
            "mode": {
              "$choice": {
                "instructions": "Which flight mode now?",
                "options": {
                  "continue": "keep flying",
                  "hold": "hover",
                  "return": "fly home",
                  "land": "land now"
                }
              }
            },
            "abort": {
              "$truth": {
                "instructions": "Should the mission be aborted now?"
              }
            }
          }
        }
      },
      "save_as": "s"
    },
    {
      "connect": "s"
    },
    {
      "send": {
        "frame": "a",
        "session": "s"
      }
    },
    {
      "read": {
        "session": "s",
        "count": 1
      }
    },
    {
      "send": {
        "frame": "b",
        "session": "s"
      }
    },
    {
      "read": {
        "session": "s",
        "count": 1
      }
    },
    {
      "end": "s"
    }
  ],
  "expect": {
    "session_events": [
      {
        "frame_error": {
          "seq": 1,
          "error_type": "rate_limit_error",
          "retry_after_ms": 1000
        }
      },
      {
        "reply": {
          "seq": 2
        }
      },
      {
        "ended": true
      }
    ]
  }
}
