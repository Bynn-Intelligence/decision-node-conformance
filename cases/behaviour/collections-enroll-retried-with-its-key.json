{
  "id": "collections-enroll-retried-with-its-key",
  "description": "collections.enroll carries an Idempotency-Key, a new UUID per call and the same on every attempt, so the server enrolls and bills once however often it is tried; it is then retried like any call: a 500, then the answer, two attempts with one key.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "collections.enroll",
    "args": {
      "collection_id": "col_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80",
      "image": {
        "$image": {
          "id": "badge",
          "url": "https://files.example.com/badges/emp-1042.jpg"
        }
      },
      "reference": "emp-1042"
    }
  },
  "mock": {
    "scenario": {
      "steps": [
        {
          "status": 500,
          "headers": {
            "content-type": "application/json"
          },
          "body": {
            "detail": {
              "error_type": "api_error",
              "message": "Something went wrong on our side."
            }
          }
        },
        {
          "status": 201,
          "headers": {
            "content-type": "application/json"
          },
          "body": {
            "id": "itm_9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d",
            "collection": "col_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80",
            "reference": "emp-1042",
            "label": null,
            "faces_found": 1,
            "box": {
              "x1": 412,
              "y1": 220,
              "x2": 580,
              "y2": 470
            },
            "created_at": "2026-10-12T09:00:00Z",
            "usage": {
              "enrollments": 1,
              "cost": {
                "usd": 0.001
              }
            }
          }
        }
      ],
      "after": "repeat_last"
    }
  },
  "expect": {
    "attempts": 2,
    "same_header": {
      "name": "idempotency-key",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "outcome": {
      "result": "item"
    }
  }
}
