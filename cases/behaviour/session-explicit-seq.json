{
  "id": "session-explicit-seq",
  "description": "send(seq=17) sends that number and the reply carries it back.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "steps": [
    {
      "call": {
        "method": "open_session",
        "args": {
          "state": {
            "mission": "Survey the north field"
          },
          "questions": {
            "mode": {
              "$choice": {
                "instructions": "Which flight mode now?",
                "options": {
                  "continue": "keep flying",
                  "hold": "hover",
                  "return": "fly home",
                  "land": "land now"
                }
              }
            },
            "abort": {
              "$truth": {
                "instructions": "Should the mission be aborted now?"
              }
            }
          }
        }
      },
      "save_as": "s"
    },
    {
      "connect": "s"
    },
    {
      "send": {
        "frame": "a",
        "seq": 17,
        "session": "s"
      }
    },
    {
      "read": {
        "session": "s",
        "count": 1
      }
    },
    {
      "end": "s"
    }
  ],
  "expect": {
    "session_events": [
      {
        "reply": {
          "seq": 17
        }
      },
      {
        "ended": true
      }
    ],
    "request_sequence": [
      {
        "method": "POST",
        "path": "/v1/sessions",
        "status": 200
      },
      {
        "method": "GET",
        "path_pattern": "^/v1/sessions/ses_[0-9a-f]{24}/stream$",
        "status": 101
      },
      {
        "method": "WS",
        "path_pattern": "^/v1/sessions/ses_[0-9a-f]{24}/stream$",
        "body_checks": [
          {
            "pointer": "/seq",
            "equals": 17
          }
        ]
      },
      {
        "method": "DELETE",
        "path_pattern": "^/v1/sessions/ses_[0-9a-f]{24}$",
        "status": 200
      }
    ]
  }
}
