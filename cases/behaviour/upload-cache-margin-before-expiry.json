{
  "id": "upload-cache-margin-before-expiry",
  "description": "A cache entry is used only until 5 minutes before its expires_at. The mock's clock is set 3,400 s back, so the upload's expires_at is about 200 s away when it is made: the second decision with the same bytes must presign again.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "mock": {
    "scenario": {
      "clock_offset_seconds": -3400
    }
  },
  "steps": [
    {
      "call": {
        "method": "decide",
        "args": {
          "state": "s",
          "images": [
            {
              "$image": {
                "id": "a",
                "path": "fixtures/images/pixel.png",
                "pad_to": 600000
              }
            }
          ],
          "questions": {
            "q": {
              "$truth": {
                "instructions": "Does the receipt total equal the claim?"
              }
            }
          }
        }
      },
      "outcome": {
        "result": "decision"
      }
    },
    {
      "call": {
        "method": "decide",
        "args": {
          "state": "s",
          "images": [
            {
              "$image": {
                "id": "a",
                "path": "fixtures/images/pixel.png",
                "pad_to": 600000
              }
            }
          ],
          "questions": {
            "q": {
              "$truth": {
                "instructions": "Does the receipt total equal the claim?"
              }
            }
          }
        }
      },
      "outcome": {
        "result": "decision"
      }
    }
  ],
  "expect": {
    "request_sequence": [
      {
        "method": "POST",
        "path": "/v1/uploads",
        "status": 201
      },
      {
        "method": "PUT",
        "path_pattern": "^/_mock/s3/uploads/",
        "status": 200
      },
      {
        "method": "POST",
        "path": "/v1/decide",
        "status": 200
      },
      {
        "method": "POST",
        "path": "/v1/uploads",
        "status": 201
      },
      {
        "method": "PUT",
        "path_pattern": "^/_mock/s3/uploads/",
        "status": 200
      },
      {
        "method": "POST",
        "path": "/v1/decide",
        "status": 200
      }
    ]
  }
}
