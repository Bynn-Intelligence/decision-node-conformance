{
  "id": "retry-after-ms-capped-at-60s",
  "description": "A wait the server asks for is capped at 60 s: retry-after-ms of ten minutes schedules a 60 s wait. The test replaces the client's wait with a recorder (see scheduled_waits_ms), so it does not take 60 s.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "s",
      "questions": {
        "q": {
          "$truth": {
            "instructions": "?"
          }
        }
      }
    }
  },
  "mock": {
    "scenario": {
      "steps": [
        {
          "status": 529,
          "headers": {
            "retry-after-ms": "600000"
          },
          "body": {
            "detail": {
              "error_type": "overloaded_error",
              "message": "Overloaded."
            }
          }
        },
        {
          "action": "normal"
        }
      ]
    }
  },
  "expect": {
    "attempts": 2,
    "outcome": {
      "result": "decision"
    },
    "scheduled_waits_ms": [
      {
        "min": 59000,
        "max": 60000
      }
    ]
  }
}
