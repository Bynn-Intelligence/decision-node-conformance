{
  "id": "local-image-id-over-64-in-helper",
  "description": "The helpers check image ids the same as decide: check() with a second image whose id is 65 characters raises the API's 400 api_usage_error locally, and nothing is sent.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "check",
    "args": {
      "state": "",
      "instructions": "Is this a receipt?",
      "images": [
        {
          "$image": {
            "id": "front",
            "url": "https://files.example.com/front.jpg"
          }
        },
        {
          "$image": {
            "id": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "url": "https://files.example.com/back.jpg"
          }
        }
      ]
    }
  },
  "expect": {
    "attempts": 0,
    "outcome": {
      "error": "BadRequestError",
      "fields": {
        "status": null,
        "error_type": "api_usage_error",
        "message": "Image 1: its id is longer than 64 characters.",
        "request_id": null
      }
    }
  }
}
