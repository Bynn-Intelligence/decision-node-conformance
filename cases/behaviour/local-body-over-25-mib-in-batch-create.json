{
  "id": "local-body-over-25-mib-in-batch-create",
  "description": "batches.create with a line whose body is over 25 MiB: each line is checked as it would be sent, so the call raises RequestTooLargeError and nothing is sent.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "batches.create",
    "args": {
      "requests": [
        {
          "custom_id": "big",
          "state": {
            "$text": {
              "repeat": "a",
              "times": 26214336
            }
          },
          "questions": {
            "q": {
              "$truth": {
                "instructions": "?"
              }
            }
          }
        }
      ]
    }
  },
  "expect": {
    "attempts": 0,
    "outcome": {
      "error": "RequestTooLargeError",
      "fields": {
        "status": null,
        "error_type": "request_too_large_error",
        "message": "The request body is over 26,214,400 bytes (25 MiB). Send large images as uploads (POST /v1/uploads) and name them by upload_id.",
        "request_id": null
      }
    }
  }
}
