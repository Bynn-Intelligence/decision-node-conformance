        "args": {
          "requests": []
        }
      }
    },
    {
      "call": {
        "method": "batches.create",
        "args": {
          "requests": []
        }
      }
    },
    {
      "call": {
        "method": "batches.create",
        "args": {
          "requests": []
        }
      }
    },
    {
      "call": {
        "method": "batches.list",
        "args": {
          "limit": 2
        }
      },
      "outcome": {
        "result": "batch_page",
        "batch_page": {
          "offset": 0,
          "limit": 2,
          "total": 3,
          "next_offset": 2
