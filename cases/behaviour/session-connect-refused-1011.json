{
  "id": "session-connect-refused-1011",
  "description": "The server holding the session cannot be reached at connect: the upgrade completes and closes at once with 1011, reported as SessionClosed(1011), reopen true. A harness accepts it raised from connect() or as the first event.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "mock": {
    "scenario": {
      "session": {
        "close": {
          "on_connect": 1011
        }
      }
    }
  },
  "steps": [
    {
      "call": {
        "method": "open_session",
        "args": {
          "state": {
            "mission": "Survey the north field"
          },
          "questions": {
            "mode": {
              "$choice": {
                "instructions": "Which flight mode now?",
                "options": {
                  "continue": "keep flying",
                  "hold": "hover",
                  "return": "fly home",
                  "land": "land now"
                }
              }
            },
            "abort": {
              "$truth": {
                "instructions": "Should the mission be aborted now?"
              }
            }
          }
        }
      },
      "save_as": "s"
    },
    {
      "connect": "s"
    },
    {
      "read": {
        "session": "s",
        "timeout_ms": 15000
      }
    }
  ],
  "expect": {
    "session_events": [
      {
        "closed": {
          "code": 1011,
          "reopen": true
        }
      }
    ]
  }
}
