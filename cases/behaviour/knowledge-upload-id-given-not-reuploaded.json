{
  "id": "knowledge-upload-id-given-not-reuploaded",
  "description": "A stale upload the caller named by Document(upload_id) is raised at once: the SDK cannot upload what it does not hold.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "mock": {
    "scenario": {
      "steps": [
        {
          "status": 400,
          "headers": {
            "content-type": "application/json"
          },
          "body": {
            "detail": {
              "error_type": "upload_consumed",
              "message": "Upload upl_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80 was already added as a document. Upload the file again."
            }
          }
        }
      ],
      "after": "repeat_last"
    }
  },
  "call": {
    "method": "collections.add_document",
    "args": {
      "collection_id": "col_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80",
      "document": {
        "$document": {
          "upload_id": "upl_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80"
        }
      },
      "title": "Claims policy 2026"
    }
  },
  "expect": {
    "attempts": 1,
    "outcome": {
      "error": "BadRequestError",
      "fields": {
        "error_type": "upload_consumed"
      }
    }
  }
}
