{
  "id": "local-url-too-long",
  "description": "An https image URL of 8,224 characters, longer than any sane URL. Checked locally: the API's own error class is raised and no request reaches the mock. From suite 1.5 the case also checks the error_type the server would send (image_url_refused for a URL over 2,048 characters).",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "s",
      "images": [
        {
          "$image": {
            "id": "u",
            "url": "https://example..jpg"
          }
        }
      ],
      "questions": {
        "q": {
          "$truth": {
            "instructions": "Does the receipt total equal the claim?"
          }
        }
      }
    }
  },
  "expect": {
    "attempts": 0,
    "outcome": {
      "error": "BadRequestError",
      "fields": {
        "error_type": "image_url_refused"
      }
    }
  }
}
