{
  "id": "local-video-in-helper",
  "description": "classify() runs the video checks too. Checked locally (SDK specification 1.2): BadRequestError with the server's error_type and message, and no request reaches the mock.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "classify",
    "args": {
      "state": "s",
      "instructions": "Which way does the car turn?",
      "options": [
        "left",
        "right"
      ],
      "videos": [
        {
          "$video": {
            "id": "cam",
            "frames": [
              {
                "$frame": {
                  "t": 1,
                  "data_text": "",
                  "media_type": "image/jpeg"
                }
              },
              {
                "$frame": {
                  "t": 0.5,
                  "data_text": "",
                  "media_type": "image/jpeg"
                }
              }
            ]
          }
        }
      ]
    }
  },
  "expect": {
    "attempts": 0,
    "outcome": {
      "error": "BadRequestError",
      "fields": {
        "status": null,
        "error_type": "api_usage_error",
        "message": "Video 'cam': frame 1: t must be larger than the frame before it (1).",
        "request_id": null
      }
    }
  }
}
