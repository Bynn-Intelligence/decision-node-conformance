{
  "id": "batch-results-not-ready",
  "description": "Results of a batch that has not ended: 409 results_not_ready, not retried.",
  "client": {
    "api_key": "dn_test_conformance",
    "max_retries": 2
  },
  "steps": [
    {
      "call": {
        "method": "batches.create",
        "args": {
          "requests": [
            {
              "custom_id": "t1",
              "state": "I was charged twice.",
