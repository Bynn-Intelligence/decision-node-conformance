{
  "id": "upload-put-retry-500",
  "description": "The storage answers the first PUT 500: the PUT is retried with the same URL, headers and bytes, under the retry policy, then the decision is sent.",
  "client": {
    "api_key": "dn_test_conformance",
    "max_retries": 2
  },
  "mock": {
    "scenario": {
      "rules": [
        {
          "match": {
            "$method": "PUT"
          },
          "steps": [
            {
              "status": 500,
              "headers": {
                "content-type": "application/xml"
              },
              "body_text": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Error><Code>InternalError</Code><Message>We encountered an internal error. Please try again.</Message><RequestId>MOCK0001</RequestId></Error>"
            }
          ]
        }
      ]
    }
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "s",
      "images": [
        {
          "$image": {
            "id": "a",
            "path": "fixtures/images/pixel.png",
            "pad_to": 600000
          }
        }
      ],
      "questions": {
        "q": {
          "$truth": {
            "instructions": "Does the receipt total equal the claim?"
          }
        }
      }
    }
  },
  "expect": {
    "attempts": 4,
    "outcome": {
      "result": "decision"
    },
    "request_sequence": [
      {
        "method": "POST",
        "path": "/v1/uploads",
        "status": 201
      },
      {
        "method": "PUT",
        "path_pattern": "^/_mock/s3/uploads/",
        "status": 500
      },
      {
        "method": "PUT",
        "path_pattern": "^/_mock/s3/uploads/",
        "status": 200
      },
      {
        "method": "POST",
        "path": "/v1/decide",
        "status": 200
      }
    ],
    "scheduled_waits_ms": [
      {
        "min": 0,
        "max": 8000
      }
    ]
  }
}
