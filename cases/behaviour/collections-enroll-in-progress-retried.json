{
  "id": "collections-enroll-in-progress-retried",
  "description": "A 409 idempotency_in_progress (the first attempt with this key is still running on the server) is retried after its Retry-After with the same key, and the answer arrives.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "collections.enroll",
    "args": {
      "collection_id": "col_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80",
      "image": {
        "$image": {
          "id": "badge",
          "url": "https://files.example.com/badges/emp-1042.jpg"
        }
      },
      "reference": "emp-1042"
    }
  },
  "mock": {
    "scenario": {
      "steps": [
        {
          "status": 409,
          "headers": {
            "content-type": "application/json",
            "Retry-After": "1",
            "x-decisionnode-retry-after-ms": "1000",
            "x-decisionnode-error": "A request with this Idempotency-Key is still running. Try again shortly."
          },
          "body": {
            "detail": {
              "error_type": "idempotency_in_progress",
              "message": "A request with this Idempotency-Key is still running. Try again shortly."
            }
          }
        },
        {
          "status": 201,
          "headers": {
            "content-type": "application/json"
          },
          "body": {
            "id": "itm_9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d",
            "collection": "col_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80",
            "reference": "emp-1042",
            "label": null,
            "faces_found": 1,
            "box": {
              "x1": 412,
              "y1": 220,
              "x2": 580,
              "y2": 470
            },
            "created_at": "2026-10-12T09:00:00Z",
            "usage": {
              "enrollments": 1,
              "cost": {
                "usd": 0.001
              }
            }
          }
        }
      ],
      "after": "repeat_last"
    }
  },
  "expect": {
    "attempts": 2,
    "same_header": {
      "name": "idempotency-key"
    },
    "outcome": {
      "result": "item",
      "item": {
        "reference": "emp-1042"
      }
    }
  }
}
