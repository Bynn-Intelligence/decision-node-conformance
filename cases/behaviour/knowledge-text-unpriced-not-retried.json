{
  "id": "knowledge-text-unpriced-not-retried",
  "description": "A text write's 529 with details.reason enrollment_unpriced is never retried: no price is set, which no retry cures.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "mock": {
    "scenario": {
      "steps": [
        {
          "status": 529,
          "headers": {
            "content-type": "application/json"
          },
          "body": {
            "detail": {
              "error_type": "overloaded_error",
              "message": "Text ingestion is not available on this deployment yet.",
              "details": {
                "reason": "enrollment_unpriced"
              }
            }
          }
        }
      ],
      "after": "repeat_last"
    }
  },
  "call": {
    "method": "collections.add_document",
    "args": {
      "collection_id": "col_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80",
      "document": {
        "$document": {
          "text": "# Claims policy 2026\n\n## Receipts\n\nReject any claim over 500 SEK without a receipt.\n\n## Photos\n\nPhotos of damage taken after 2026-09-01 count as current.\n"
        }
      },
      "title": "Claims policy 2026"
    }
  },
  "expect": {
    "attempts": 1,
    "outcome": {
      "error": "OverloadedError",
      "fields": {
        "details": {
          "reason": "enrollment_unpriced"
        }
      }
    }
  }
}
