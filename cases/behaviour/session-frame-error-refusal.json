{
  "id": "session-frame-error-refusal",
  "description": "The safety check refuses a frame: refusal_error with category, the usage it billed and the safety body with blocked; a FrameError value, the session continues.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "mock": {
    "scenario": {
      "session": {
        "frame_errors": {
          "1": {
            "error_type": "refusal_error",
            "category": "harm"
          }
        }
      }
    }
  },
  "steps": [
    {
      "call": {
        "method": "open_session",
        "args": {
          "state": {
            "mission": "Survey the north field"
          },
          "questions": {
            "mode": {
              "$choice": {
                "instructions": "Which flight mode now?",
                "options": {
                  "continue": "keep flying",
                  "hold": "hover",
                  "return": "fly home",
                  "land": "land now"
                }
              }
            },
            "abort": {
              "$truth": {
                "instructions": "Should the mission be aborted now?"
              }
            }
          }
        }
      },
      "save_as": "s"
    },
    {
      "connect": "s"
    },
    {
      "send": {
        "frame": "a",
        "session": "s"
      }
    },
    {
      "read": {
        "session": "s",
        "count": 1
      }
    },
    {
      "send": {
        "frame": "b",
        "session": "s"
      }
    },
    {
      "read": {
        "session": "s",
        "count": 1
      }
    },
    {
      "end": "s"
    }
  ],
  "expect": {
    "session_events": [
      {
        "frame_error": {
          "seq": 1,
          "error_type": "refusal_error",
          "category": "harm",
          "safety": {
            "checked": true,
            "harm": 0.912,
            "self_harm": 0.0041,
            "flagged": [
              "harm"
            ],
            "blocked": "harm"
          },
          "usage": {
            "output_tokens": 0
          }
        }
      },
      {
        "reply": {
          "seq": 2
        }
      },
      {
        "ended": true
      }
    ]
  }
}
