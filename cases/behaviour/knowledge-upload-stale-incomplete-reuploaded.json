{
  "id": "knowledge-upload-stale-incomplete-reuploaded",
  "description": "A 400 upload_incomplete on the item call, for the upload this call placed: the SDK uploads the document again and sends the item call once more, with a new Idempotency-Key since its body changed. max_retries 0 shows the resend is not a retry.",
  "client": {
    "api_key": "dn_test_conformance",
    "max_retries": 0
  },
  "mock": {
    "scenario": {
      "rules": [
        {
          "match": {
            "$method": "POST",
            "$path": "/v1/collections/col_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80/items"
          },
          "steps": [
            {
              "status": 400,
              "headers": {
                "content-type": "application/json"
              },
              "body": {
                "detail": {
                  "error_type": "upload_incomplete",
                  "message": "Upload upl_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80 has no bytes of its declared size yet. PUT the file to its URL first."
                }
              }
            },
            {
              "status": 202,
              "headers": {
                "content-type": "application/json"
              },
              "body": {
                "id": "itm_9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d",
                "reference": "policy-2026",
                "label": null,
                "metadata": {},
                "created_at": "2026-10-20T11:00:00Z",
                "title": "Claims policy 2026",
                "format": null,
                "pinned": false,
                "pin_rank": 0,
                "source": "file",
                "file": null,
                "status": "queued",
                "stage": null,
                "progress": null,
                "serving": "none",
                "error": null,
                "delayed": false,
                "warnings": [],
                "chunks": 0,
                "tokens": 0,
                "content_sha256": "8c1f1e6b2a7d4c3b9e0f5a6d7c8b9a0e1f2d3c4b5a6978e0d1c2b3a4f5e6d7c8",
                "version": 1,
                "queued_at": "2026-10-20T11:00:01Z",
                "ready_at": null
              }
            }
          ]
        }
      ]
    }
  },
  "call": {
    "method": "collections.add_document",
    "args": {
      "collection_id": "col_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80",
      "document": {
        "$document": {
          "path": "fixtures/knowledge/claims-policy.pdf"
        }
      },
      "reference": "policy-2026"
    }
  },
  "expect": {
    "attempts": 6,
    "outcome": {
      "result": "item"
    },
    "distinct_header": {
      "name": "idempotency-key",
      "path_suffix": "/items",
      "method": "POST",
      "count": 2
    },
    "request_sequence": [
      {
        "method": "POST",
        "path": "/v1/uploads",
        "status": 201
      },
      {
        "method": "PUT",
        "path_pattern": "^/_mock/s3/uploads/",
        "status": 200
      },
      {
        "method": "POST",
        "path": "/v1/collections/col_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80/items",
        "status": 400
      },
      {
        "method": "POST",
        "path": "/v1/uploads",
        "status": 201
      },
      {
        "method": "PUT",
        "path_pattern": "^/_mock/s3/uploads/",
        "status": 200
      },
      {
        "method": "POST",
        "path": "/v1/collections/col_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80/items",
        "status": 202
      }
    ]
  }
}
