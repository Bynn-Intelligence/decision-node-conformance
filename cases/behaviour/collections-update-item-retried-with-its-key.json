{
  "id": "collections-update-item-retried-with-its-key",
  "description": "collections.update_item carries an Idempotency-Key, the same on every attempt, and is retried like any call: a 500, then the answer, two attempts with one key.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "mock": {
    "scenario": {
      "steps": [
        {
          "status": 500,
          "headers": {
            "content-type": "application/json"
          },
          "body": {
            "detail": {
              "error_type": "api_error",
              "message": "Something went wrong on our side."
            }
          }
        },
        {
          "status": 200,
          "headers": {
            "content-type": "application/json"
          },
          "body": {
            "id": "itm_9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d",
            "reference": "emp-1042",
            "label": "Anna, reception",
            "metadata": {
              "department": "Reception",
              "badge_level": 2,
              "visitor": false
            },
            "created_at": "2026-10-12T09:00:00Z"
          }
        }
      ],
      "after": "repeat_last"
    }
  },
  "call": {
    "method": "collections.update_item",
    "args": {
      "collection_id": "col_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80",
      "item_id": "itm_9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d",
      "label": "Anna, reception"
    }
  },
  "expect": {
    "attempts": 2,
    "same_header": {
      "name": "idempotency-key",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "outcome": {
      "result": "item"
    }
  }
}
