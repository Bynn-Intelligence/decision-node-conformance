{
  "id": "video-accepted-usage",
  "description": "A video of three frames half a second apart reaches the API: the decision carries usage.video_frames (3 read at the default 2 a second) and usage.video_seconds (1.5: to the last frame plus the median gap), and no warnings.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "s",
      "videos": [
        {
          "$video": {
            "id": "cam",
            "frames": [
              {
                "$frame": {
                  "t": 0,
                  "data_text": "",
                  "media_type": "image/jpeg"
                }
              },
              {
                "$frame": {
                  "t": 0.5,
                  "data_text": "",
                  "media_type": "image/jpeg"
                }
              },
              {
                "$frame": {
                  "t": 1,
                  "data_text": "",
                  "media_type": "image/jpeg"
                }
              }
            ]
          }
        }
      ],
      "questions": {
        "q": {
          "$truth": {
            "instructions": "Is the door open?"
          }
        }
      }
    }
  },
  "expect": {
    "attempts": 1,
    "outcome": {
      "result": "decision",
      "decision": {
        "model": {
          "$pattern": "^decisionnode-moe-"
        },
        "warnings": [],
        "usage": {
          "video_frames": 3,
          "video_seconds": 1.5
        }
      }
    }
  }
}
