{
  "id": "local-collections-name-too-long",
  "description": "A collection name of 81 characters: a name is 1 to 80. Checked locally (a limit a client may hold): ValidationError with the entry the API answers; nothing is sent.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "collections.create",
    "args": {
      "name": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    }
  },
  "expect": {
    "attempts": 0,
    "outcome": {
      "error": "ValidationError",
      "fields": {
        "status": null,
        "request_id": null,
        "entries": [
          {
            "type": "string_too_long",
            "loc": [
              "body",
              "name"
            ],
            "msg": "String should have at most 80 characters",
            "input": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
            "ctx": {
              "max_length": 80
            }
          }
        ]
      }
    }
  }
}
