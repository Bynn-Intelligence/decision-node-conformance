{
  "id": "upload-seventeen-refused",
  "description": "upload() of seventeen images: one presign takes 1 to 16 files, so the presign's own 400 api_usage_error is raised before anything is sent.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "upload",
    "args": {
      "images": {
        "$list": {
          "count": 17,
          "item": {
            "$image": {
              "id": "i{i}",
              "path": "fixtures/images/pixel.png"
            }
          }
        }
      }
    }
  },
  "expect": {
    "attempts": 0,
    "outcome": {
      "error": "BadRequestError",
      "fields": {
        "status": null,
        "error_type": "api_usage_error",
        "message": "files: 1 to 16 files, got 17."
      }
    }
  }
}
