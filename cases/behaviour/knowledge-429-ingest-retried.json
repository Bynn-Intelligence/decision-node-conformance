{
  "id": "knowledge-429-ingest-retried",
  "description": "The ingestion 429 rate_limit_error is retried as every 429, after its retry-after-ms, with the same Idempotency-Key.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "mock": {
    "scenario": {
      "steps": [
        {
          "status": 429,
          "headers": {
            "content-type": "application/json",
            "retry-after": "1",
            "retry-after-ms": "50"
          },
          "body": {
            "detail": {
              "error_type": "rate_limit_error",
              "message": "This workspace has reached its ingestion rate. Retry later.",
              "details": {
                "reason": "ingest_tokens_per_hour"
              }
            }
          }
        },
        {
          "status": 202,
          "headers": {
            "content-type": "application/json"
          },
