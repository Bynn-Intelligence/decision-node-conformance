{
  "id": "upload-cache-reuse-same-bytes",
  "description": "Two decisions with the same image bytes (under another image id) on one client: the second reuses the cached upload_id. One presign and one PUT in all.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "steps": [
    {
      "call": {
        "method": "decide",
        "args": {
          "state": "s",
          "images": [
            {
              "$image": {
                "id": "a",
                "path": "fixtures/images/pixel.png",
                "pad_to": 600000
              }
            }
          ],
          "questions": {
            "q": {
              "$truth": {
                "instructions": "Does the receipt total equal the claim?"
              }
            }
          }
        }
      },
      "outcome": {
        "result": "decision"
      }
    },
    {
      "call": {
        "method": "decide",
        "args": {
          "state": "t",
          "images": [
            {
              "$image": {
                "id": "b",
                "path": "fixtures/images/pixel.png",
                "pad_to": 600000
              }
            }
          ],
          "questions": {
            "q": {
              "$truth": {
                "instructions": "Does the receipt total equal the claim?"
              }
            }
          }
        }
      },
      "outcome": {
        "result": "decision"
      }
    }
  ],
  "expect": {
    "request_sequence": [
      {
        "method": "POST",
        "path": "/v1/uploads",
        "status": 201
      },
      {
        "method": "PUT",
        "path_pattern": "^/_mock/s3/uploads/",
        "status": 200
      },
      {
        "method": "POST",
        "path": "/v1/decide",
        "status": 200
      },
      {
        "method": "POST",
        "path": "/v1/decide",
        "status": 200,
        "body_checks": [
          {
            "pointer": "/images/0/id",
            "equals": "b"
          },
          {
            "pointer": "/images/0/upload_id",
            "pattern": "^upl_[0-9a-f]{32}$"
          },
          {
            "pointer": "/images/0/data",
            "absent": true
          },
          {
            "pointer": "/images/0/url",
            "absent": true
          }
        ]
      }
    ]
  }
}
