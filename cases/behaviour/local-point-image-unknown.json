  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "images": [
        {
          "$image": {
            "id": "belt",
            "url": "https://files.example.com/line-3/cam-2/0917.jpg"
