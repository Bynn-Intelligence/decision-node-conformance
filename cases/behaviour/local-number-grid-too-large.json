{
  "id": "local-number-grid-too-large",
  "description": "A number grid of 10,001 values, over 4,096 (the API's 422 too_long). Checked locally: the API's own error class is raised and no request reaches the mock. From suite 1.5 the case also checks the error_type the server would send (null: a 422 has a list for its detail) and the API's entries exactly.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "s",
      "questions": {
        "n": {
          "$number": {
            "instructions": "Percent?",
            "min": 0,
            "max": 1000,
            "step": 0.1
          }
        }
      }
    }
  },
  "expect": {
    "attempts": 0,
    "outcome": {
      "error": "ValidationError",
      "fields": {
        "error_type": null,
        "entries": [
          {
            "type": "too_long",
            "loc": [
              "body",
              "questions",
              "n",
              "number"
            ],
            "msg": "Grid should have at most 4096 values, not 10001",
            "input": {
              "type": "number",
              "instructions": "Percent?",
              "min": 0,
              "max": 1000,
              "step": 0.1
            },
            "ctx": {
              "field_type": "Grid",
              "max_length": 4096,
              "actual_length": 10001
            }
          }
        ]
      }
    }
  }
}
