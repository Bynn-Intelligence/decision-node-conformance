{
  "id": "keys-create-retried-with-its-key",
  "description": "keys.create carries one Idempotency-Key on every attempt, so it is retried like any call: a 500, then the key, two attempts with one key.",
  "client": {
    "api_key": "dn_test_scope-keys"
  },
  "mock": {
    "scenario": {
      "steps": [
        {
          "status": 500,
          "headers": {
            "content-type": "application/json"
          },
          "body": {
            "detail": {
              "error_type": "api_error",
              "message": "Something went wrong on our side."
            }
          }
        },
        {
          "status": 201,
          "headers": {
            "content-type": "application/json"
          },
          "body": {
            "key": {
              "id": "key_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80",
              "name": "Drone 7",
              "prefix": "dn_live_",
              "last4": "a1b2",
              "status": "active",
              "scope": "decide",
              "may_search_collections": false,
              "limits": {
                "requests_per_second": 5,
                "tokens_per_second": 2000
              },
              "daily_spend_cap": {
                "usd": 2.5
              },
              "spent_today": {
                "usd": 0
              },
              "expires_at": "2027-10-01T00:00:00Z",
              "device_id": "drone-7",
              "labels": {
                "customer": "acme",
                "fleet": "north"
              },
              "created_by_key": {
                "id": "key_00000000000000000000000000000e05"
              },
              "created_at": "2026-10-14T09:00:00Z",
              "last_used_at": null,
              "revoked_at": null
            },
            "secret": "dn_live_0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
          }
        }
      ],
      "after": "repeat_last"
    }
  },
  "call": {
    "method": "keys.create",
    "args": {
      "name": "Drone 7"
    }
  },
  "expect": {
    "attempts": 2,
    "same_header": {
      "name": "idempotency-key",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "outcome": {
      "result": "created_key"
    }
  }
}
