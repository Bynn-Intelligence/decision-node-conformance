{
  "id": "session-open-rate-limit-retried",
  "description": "A 429 rate_limit_error on open is retried like any call (only session_limit_exceeded is not).",
  "client": {
    "api_key": "dn_test_conformance",
    "max_retries": 2
  },
  "mock": {
    "scenario": {
      "rules": [
        {
          "match": {
            "$path": "/v1/sessions"
          },
          "steps": [
            {
              "status": 429,
              "body": {
                "detail": {
                  "error_type": "rate_limit_error",
                  "message": "Rate limit exceeded."
                }
              },
              "headers": {
                "retry-after-ms": "50"
              }
            }
          ]
        }
      ]
    }
  },
  "call": {
    "method": "open_session",
    "args": {
      "questions": {
        "abort": {
          "$truth": {
            "instructions": "Abort?"
          }
        }
      }
    }
  },
  "expect": {
    "attempts": 2,
    "outcome": {
      "result": "session",
      "session": {
        "model": {
          "$pattern": "^decisionnode-moe-"
        },
        "questions": [
          "abort"
        ],
        "window": 8,
        "ttl_seconds": 300
      }
    }
  }
}
