{
  "id": "local-state-wrong-type",
  "description": "decide() with a state that is a number: a state is a string, an object or an array, so the API's three 422 entries (A request without a state). Checked locally: the API's own error class is raised and no request reaches the mock.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": 42,
      "questions": {
        "q": {
          "$truth": {
            "instructions": "Does the receipt total equal the claim?"
          }
        }
      }
    }
  },
  "expect": {
    "attempts": 0,
    "outcome": {
      "error": "ValidationError",
      "fields": {
        "error_type": null,
        "entries": [
          {
            "type": "string_type",
            "loc": [
              "body",
              "state",
              "str"
            ],
            "msg": "Input should be a valid string",
            "input": 42
          },
          {
            "type": "dict_type",
            "loc": [
              "body",
              "state",
              "dict[any,any]"
            ],
            "msg": "Input should be a valid dictionary",
            "input": 42
          },
          {
            "type": "list_type",
            "loc": [
              "body",
              "state",
              "list[any]"
            ],
            "msg": "Input should be a valid list",
            "input": 42
          }
        ]
      }
    }
  }
}
