{
  "id": "boosters-vision-answered-by-mock",
  "description": "The mock answers Depth Vision and Segment Vision with fixed readings per image: the decision's evidence holds a DepthReading (a 2 by 2 grid, as asked) and a SegmentReading whose prompts are the phrases as the API cleans them (\"|\" a space, white space folded, the ends trimmed, a repeat in another case dropped), in the request's order. Each picture read is one call, billed once.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "",
      "images": [
        {
          "$image": {
            "id": "gate",
            "url": "https://files.example.com/drone/gate-3.jpg"
          }
        }
      ],
      "questions": {
        "gate_ahead": {
          "$truth": {
            "instructions": "Is the drone lined up with the gate's opening?"
          }
        }
      },
      "boosters": [
        {
          "$booster": {
            "name": "bynn_depth",
            "options": {
              "grid_size": 2
            }
          }
        },
        {
          "$booster": {
            "name": "bynn_segment",
            "options": {
              "prompt": [
                "purple gate",
                " Landing  pad|",
                "purple GATE"
              ],
              "polygon_points": 4,
              "max_instances": 2
            }
          }
        }
      ]
    }
  },
  "expect": {
    "attempts": 1,
    "outcome": {
