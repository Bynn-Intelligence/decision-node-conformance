{
  "id": "local-video-in-decide-many",
  "description": "decide_many with a video fault in its second request: every request is checked before any is sent, the fault raises for the whole call and nothing is sent.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide_many",
    "args": {
      "requests": [
        {
          "state": "a",
          "questions": {
            "q": {
              "$truth": {
                "instructions": "Is the door open?"
              }
            }
          },
          "videos": [
            {
              "$video": {
                "id": "cam",
                "frames": [
                  {
                    "$frame": {
                      "t": 0,
                      "data_text": "",
                      "media_type": "image/jpeg"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "state": "b",
          "questions": {
            "q": {
              "$truth": {
                "instructions": "Is the door open?"
              }
            }
          },
          "videos": [
            {
              "$video": {
                "id": "cam",
                "frames": [
                  {
                    "$frame": {
                      "t": 0,
                      "data_text": "",
                      "media_type": "image/jpeg"
                    }
                  }
                ],
                "start": 3,
                "end": 1
              }
            }
          ]
        }
      ]
    }
  },
  "expect": {
    "attempts": 0,
    "outcome": {
      "error": "BadRequestError",
      "fields": {
        "status": null,
        "error_type": "api_usage_error",
        "message": "Video 'cam': end must be after start."
      }
    }
  }
}
