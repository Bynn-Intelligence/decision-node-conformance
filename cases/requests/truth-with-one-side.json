{
  "id": "truth-with-one-side",
  "description": "truth with only the true side sends only that side.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "",
      "questions": {
        "q": {
          "$truth": {
            "instructions": "Is this spam?",
            "true": "unsolicited bulk advertising"
          }
        }
      }
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/decide",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body": {
        "model": "decisionnode-moe",
        "state": "",
        "questions": {
          "q": {
            "type": "truth",
            "instructions": "Is this spam?",
            "criteria": {
              "true": "unsolicited bulk advertising"
            }
          }
        }
      }
    }
  }
}
