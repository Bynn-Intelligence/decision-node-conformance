{
  "id": "batch-create-boosters-line",
  "description": "A batch line carries its request's boosters as the live call sends them; a line without boosters has no boosters key.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "batches.create",
    "args": {
      "requests": [
        {
          "custom_id": "p1",
          "state": "",
          "images": [
            {
              "$image": {
                "id": "person",
                "url": "https://files.example.com/person.jpg"
              }
            }
          ],
          "questions": {
            "adult": {
              "$truth": {
                "instructions": "Is the person in the first picture an adult?"
              }
            }
          },
          "boosters": [
            "age",
            {
              "$booster": {
                "name": "ai_generated",
                "require": true
              }
            }
          ]
        },
        {
          "custom_id": "p2",
          "state": "",
          "images": [
            {
              "$image": {
                "id": "poster",
                "url": "https://files.example.com/poster.jpg"
              }
            }
          ],
          "questions": {
            "synthetic": {
              "$truth": {
                "instructions": "Is the second picture AI-generated?"
              }
            }
          }
        }
      ]
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/batches",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$"
      },
      "jsonl_count": 2,
      "jsonl_checks": [
        {
          "line": 0,
          "pointer": "/custom_id",
          "equals": "p1"
        },
        {
          "line": 0,
          "pointer": "/boosters",
          "equals": [
            "age",
            {
              "name": "ai_generated",
              "require": true
            }
          ]
        },
        {
          "line": 1,
          "pointer": "/custom_id",
          "equals": "p2"
        },
        {
          "line": 1,
          "pointer": "/boosters",
          "absent": true
        }
      ]
    }
  }
}
