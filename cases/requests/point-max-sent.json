{
  "id": "point-max-sent",
  "description": "A point question with max and normalized units sends both in the question as given.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "images": [
        {
          "$image": {
            "id": "platform",
            "url": "https://files.example.com/platform/0917.jpg"
          }
        }
      ],
      "questions": {
        "people": {
          "$point": {
            "instructions": "Each person standing on the platform.",
            "units": "normalized",
            "max": 6
          }
        }
      }
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/decide",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body": {
        "model": "decisionnode-moe",
        "state": "",
        "images": [
          {
            "id": "platform",
            "url": "https://files.example.com/platform/0917.jpg"
          }
        ],
        "questions": {
          "people": {
            "type": "point",
            "instructions": "Each person standing on the platform.",
            "units": "normalized",
            "max": 6
          }
        }
      }
    }
  }
}
