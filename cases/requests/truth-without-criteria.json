{
  "id": "truth-without-criteria",
  "description": "truth(instructions) leaves the criteria key out entirely when neither side is given.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "Is hotdog a sandwich?",
      "questions": {
        "q": {
          "$truth": {
            "instructions": "Is the statement true?"
          }
        }
      }
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/decide",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body": {
        "model": "decisionnode-moe",
        "state": "Is hotdog a sandwich?",
        "questions": {
          "q": {
            "type": "truth",
            "instructions": "Is the statement true?"
          }
        }
      }
    }
  }
}
