{
  "id": "batch-create-fallback-line",
  "description": "A batch line carries its request's fallback as given; a line without it has no fallback key. (Batch lines never fall back: they wait in the queue. The field is sent all the same.)",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "batches.create",
    "args": {
      "requests": [
        {
          "custom_id": "t1",
          "state": "I was charged twice.",
          "questions": {
            "route": {
              "$choice": {
                "instructions": "Where should this go?",
                "options": [
                  "billing",
                  "bug"
                ]
              }
            }
          },
          "model": "decisionnode-moe",
          "fallback": false
        },
        {
          "custom_id": "t2",
          "state": "I was charged twice.",
          "questions": {
            "route": {
              "$choice": {
                "instructions": "Where should this go?",
                "options": [
                  "billing",
                  "bug"
                ]
              }
            }
          },
          "model": "decisionnode-moe"
        }
      ]
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/batches",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$"
      },
      "jsonl_count": 2,
      "jsonl_checks": [
        {
          "line": 0,
          "pointer": "/fallback",
          "equals": false
        },
        {
          "line": 1,
          "pointer": "/fallback",
          "absent": true
        }
      ]
    }
  }
}
