{
  "id": "number-builder-negative-and-decimals",
  "description": "Negative and decimal bounds are sent as given: min -40.5, max 10.25, step 0.25.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "s",
      "questions": {
        "t": {
          "$number": {
            "instructions": "Temperature?",
            "min": -40.5,
            "max": 10.25,
            "step": 0.25
          }
        }
      }
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/decide",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body": {
        "model": "decisionnode-moe",
        "state": "s",
        "questions": {
          "t": {
            "type": "number",
            "instructions": "Temperature?",
            "min": -40.5,
            "max": 10.25,
            "step": 0.25
          }
        }
      }
    }
  }
}
