{
  "id": "upload-at-threshold-override",
  "description": "The client's inline_threshold set to 633 bytes and one image of exactly 633 bytes: at the threshold the image is uploaded, not inlined.",
  "client": {
    "api_key": "dn_test_conformance",
    "inline_threshold": 633
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "s",
      "images": [
        {
          "$image": {
            "id": "photo",
            "path": "fixtures/images/pixel.jpg"
          }
        }
      ],
      "questions": {
        "q": {
          "$truth": {
            "instructions": "Does the receipt total equal the claim?"
          }
        }
      }
    }
  },
  "expect": {
    "requests": [
      {
        "method": "POST",
        "path": "/v1/uploads",
        "headers": {
          "authorization": "Bearer dn_test_conformance"
        },
        "header_patterns": {
          "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
          "content-type": "^application/json(;.*)?$"
        },
        "body": {
          "files": [
            {
              "content_type": "image/jpeg",
              "byte_size": 633,
              "checksum": "/b9aBxp9ZEyKivwbCwgtQA==",
              "sha256": "YVgQnO+IAmByODmMeJKWkBhHfXjZIhBFCmi+hJjk7H0="
            }
          ]
        }
      },
      {
        "method": "PUT",
        "path_pattern": "^/_mock/s3/uploads/",
        "headers": {
          "content-type": "image/jpeg",
          "content-md5": "/b9aBxp9ZEyKivwbCwgtQA==",
          "if-none-match": "*",
          "x-amz-checksum-sha256": "YVgQnO+IAmByODmMeJKWkBhHfXjZIhBFCmi+hJjk7H0="
        },
        "absent_headers": [
          "authorization",
          "x-mock-session",
          "x-mock-scenario"
        ],
        "body_sha256": "6158109cef8802607238398c7892969018477d78d92210450a68be8498e4ec7d"
      },
      {
        "method": "POST",
        "path": "/v1/decide",
        "headers": {
          "authorization": "Bearer dn_test_conformance"
        },
        "header_patterns": {
          "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
          "content-type": "^application/json(;.*)?$"
        },
        "body_checks": [
          {
            "pointer": "/model",
            "equals": "decisionnode-moe"
          },
          {
            "pointer": "/state",
            "equals": "s"
          },
          {
            "pointer": "/images/0/id",
            "equals": "photo"
          },
          {
            "pointer": "/images/0/upload_id",
            "pattern": "^upl_[0-9a-f]{32}$"
          },
          {
            "pointer": "/images/0/data",
            "absent": true
          },
          {
            "pointer": "/images/0/url",
            "absent": true
          }
        ]
      }
    ]
  }
}
