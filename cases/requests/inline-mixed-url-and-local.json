{
  "id": "inline-mixed-url-and-local",
  "description": "A URL image and a small local image: the URL passes through, the local bytes (79, under the threshold) go inline, in one request.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "s",
      "images": [
        {
          "$image": {
            "id": "diagram",
            "url": "https://example.com/diagram.png"
          }
        },
        {
          "$image": {
            "id": "receipt",
            "path": "fixtures/images/pixel.png"
          }
        }
      ],
      "questions": {
        "q": {
          "$truth": {
            "instructions": "Does the receipt total equal the claim?"
          }
        }
      }
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/decide",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body_checks": [
        {
          "pointer": "/model",
          "equals": "decisionnode-moe"
        },
        {
          "pointer": "/state",
          "equals": "s"
        },
        {
          "pointer": "/images",
          "equals": [
            {
              "id": "diagram",
              "url": "https://example.com/diagram.png"
            },
            {
              "id": "receipt",
              "media_type": "image/png",
              "data": "iVBORw0KGgoAAAANSUhEUgAAAAIAAAACCAIAAAD91JpzAAAAFklEQVR4nGM8ISfHwMDAxMDAwMDAAAANBAEIfXHKZgAAAABJRU5ErkJggg=="
            }
          ]
        }
      ]
    }
  }
}
