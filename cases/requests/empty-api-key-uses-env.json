{
  "id": "empty-api-key-uses-env",
  "description": "An explicitly empty api_key counts as not given: DECISIONNODE_API_KEY applies.",
  "client": {
    "api_key": ""
  },
  "env": {
    "DECISIONNODE_API_KEY": "dn_test_from_env"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "s",
      "questions": {
        "q": {
          "$truth": {
            "instructions": "?"
          }
        }
      }
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/decide",
      "headers": {
        "authorization": "Bearer dn_test_from_env"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body": {
        "model": "decisionnode-moe",
        "state": "s",
        "questions": {
          "q": {
            "type": "truth",
            "instructions": "?"
          }
        }
      }
    }
  }
}
