{
  "id": "batch-create-video-line",
  "description": "A batch request's videos go in its line as the live call sends them.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "batches.create",
    "args": {
      "requests": [
        {
          "custom_id": "clip-1",
          "state": "Loading dock.",
          "questions": {
            "fall": {
              "$truth": {
                "instructions": "Does a person fall in the video?"
              }
            }
          },
          "videos": [
            {
              "$video": {
                "id": "dock",
                "frames": [
                  {
                    "$frame": {
                      "t": 0,
                      "data_text": "",
                      "media_type": "image/jpeg"
                    }
                  },
                  {
                    "$frame": {
                      "t": 0.5,
                      "data_text": "",
                      "media_type": "image/jpeg"
                    }
                  }
                ],
                "fps": 2
              }
            }
          ]
        }
      ]
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/batches",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$"
      },
      "jsonl_count": 1,
      "jsonl_checks": [
        {
          "line": 0,
          "pointer": "/custom_id",
          "equals": "clip-1"
        },
        {
          "line": 0,
          "pointer": "/videos",
          "equals": [
            {
              "id": "dock",
              "fps": 2,
              "frames": [
                {
                  "t": 0,
                  "media_type": "image/jpeg",
                  "data": ""
                },
                {
                  "t": 0.5,
                  "media_type": "image/jpeg",
                  "data": ""
                }
              ]
            }
          ]
        },
        {
          "line": 0,
          "pointer": "/questions",
          "equals": {
            "fall": {
              "type": "truth",
              "instructions": "Does a person fall in the video?"
            }
          }
        }
      ]
    }
  }
}
