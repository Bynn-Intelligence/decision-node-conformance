  "client": {
    "api_key": "dn_test_conformance",
    "headers": {
      "x-decisionnode-safety-body": "true"
    }
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "s",
      "questions": {
        "q": {
          "$truth": {
            "instructions": "?"
          }
        }
      }
    }
  },
  "expect": {
