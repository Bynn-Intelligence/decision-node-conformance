{
  "id": "collections-create-sent",
  "description": "collections.create sends POST /v1/collections with the type and the name: {\"type\": \"face\", \"name\": ...}; face is the default type. It carries an Idempotency-Key, a new UUID (version 4) per call.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "collections.create",
    "args": {
      "name": "Staff, Stockholm office"
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/collections",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$",
        "idempotency-key": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      },
      "body": {
        "type": "face",
        "name": "Staff, Stockholm office"
      }
    }
  }
}
