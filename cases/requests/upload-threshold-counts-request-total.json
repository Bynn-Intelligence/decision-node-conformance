{
  "id": "upload-threshold-counts-request-total",
  "description": "inline_threshold 700: a PNG of 79 bytes and a JPEG of 633 bytes, each under it, total 712 bytes, so both are uploaded in one presign.",
  "client": {
    "api_key": "dn_test_conformance",
    "inline_threshold": 700
  },
  "call": {
    "method": "decide",
