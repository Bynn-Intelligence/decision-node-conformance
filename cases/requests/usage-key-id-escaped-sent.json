{
  "id": "usage-key-id-escaped-sent",
  "description": "usage.key puts the key id in the path escaped as a path segment: a slash in it is %2F, never a new segment. (The mock answers this case from its scenario.)",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "usage.key",
    "args": {
      "key_id": "key_a/b"
    }
  },
  "mock": {
    "scenario": {
      "steps": [
        {
          "status": 200,
          "headers": {
            "content-type": "application/json"
          },
          "body": {
            "key": {
              "id": "key_00000000000000000000000000000d01",
              "name": "Drone 1",
              "scope": "decide",
              "device_id": "drone-1",
              "labels": {
                "customer": "acme",
                "plan": "pro"
              },
              "status": "active",
              "created_at": "2026-08-20T08:00:00Z",
              "revoked_at": null,
              "expires_at": null
            },
            "period": {
              "start": "2026-09-01T00:00:00Z",
              "end": "2026-10-01T00:00:00Z"
            },
            "as_of": "2026-10-01T00:00:00Z",
            "totals": {
              "requests": 10,
              "free_tier_requests": 4,
              "input_tokens": 7400,
              "image_tokens": 1200,
              "video_tokens": 0,
              "booster_calls": 1,
              "cost": {
                "usd": 0.024213,
                "model_usd": 0.000213,
                "boosters_usd": 0.024
              }
            }
          }
        }
      ]
    }
  },
  "expect": {
    "request": {
      "method": "GET",
      "path": "/v1/keys/key_a%2Fb/usage",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$"
      }
    }
  }
}
