{
  "id": "keys-update-sent",
  "description": "keys.update sends PATCH /v1/keys/{key_id} with the fields given: a field given as null (labels here) is sent as null, which clears it. (The mock answers this case from its scenario.)",
  "client": {
    "api_key": "dn_test_scope-keys"
  },
  "call": {
    "method": "keys.update",
    "args": {
      "key_id": "key_00000000000000000000000000000d01",
      "name": "Drone 1b",
      "labels": null,
      "daily_spend_cap": {
        "usd": 1
      }
    }
  },
  "mock": {
    "scenario": {
      "steps": [
        {
          "status": 200,
          "headers": {
            "content-type": "application/json"
          },
          "body": {
            "id": "key_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80",
            "name": "Drone 7",
            "prefix": "dn_live_",
            "last4": "a1b2",
            "status": "active",
            "scope": "decide",
            "may_search_collections": false,
            "limits": {
              "requests_per_second": 5,
              "tokens_per_second": 2000
            },
            "daily_spend_cap": {
              "usd": 2.5
            },
            "spent_today": {
              "usd": 0
            },
            "expires_at": "2027-10-01T00:00:00Z",
            "device_id": "drone-7",
            "labels": {
              "customer": "acme",
              "fleet": "north"
            },
            "created_by_key": {
              "id": "key_00000000000000000000000000000e05"
            },
            "created_at": "2026-10-14T09:00:00Z",
            "last_used_at": null,
            "revoked_at": null
          }
        }
      ]
    }
  },
  "expect": {
    "request": {
      "method": "PATCH",
      "path": "/v1/keys/key_00000000000000000000000000000d01",
      "headers": {
        "authorization": "Bearer dn_test_scope-keys"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body": {
        "name": "Drone 1b",
        "labels": null,
        "daily_spend_cap": {
          "usd": 1
        }
      }
    }
  }
}
