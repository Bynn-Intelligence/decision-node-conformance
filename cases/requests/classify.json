{
  "id": "classify",
  "description": "classify(state, instructions, options) sends one choice question under the id \"classify\".",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "classify",
    "args": {
      "state": {
        "ticket": "I was charged twice and nobody has replied for 3 days."
      },
      "instructions": "Where should this go?",
      "options": {
        "billing": "money",
        "bug": "broken",
        "account": "login"
      }
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/decide",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body": {
        "model": "decisionnode-moe",
        "state": {
          "ticket": "I was charged twice and nobody has replied for 3 days."
        },
        "questions": {
          "classify": {
            "type": "choice",
            "instructions": "Where should this go?",
            "criteria": {
              "billing": "money",
              "bug": "broken",
              "account": "login"
            }
          }
        }
      }
    }
  }
}
