{
  "id": "batch-create-knowledge-line-sent",
  "description": "A batch line carries the knowledge booster as a live request does: its boosters as the knowledge builder writes them.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "batches.create",
    "args": {
      "requests": [
        {
          "custom_id": "claim-1",
          "state": {
            "claim": {
              "amount": "740.00",
              "receipt": false
            },
            "mission": "M-42"
          },
          "questions": {
            "approve": {
              "$truth": {
                "instructions": "Should the claim be approved under our policy?"
              }
            }
          },
          "boosters": [
            {
              "$knowledge": {
                "collection": "col_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80",
                "scope": "M-42"
              }
            }
          ]
        }
      ]
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/batches",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$"
      },
      "jsonl_count": 1,
      "jsonl_checks": [
        {
          "line": 0,
          "pointer": "/boosters/0",
          "equals": {
            "name": "knowledge",
            "options": {
              "collection": "col_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80",
              "scope": "M-42"
            }
          }
        }
      ]
    }
  }
