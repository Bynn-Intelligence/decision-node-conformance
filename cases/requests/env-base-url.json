{
  "id": "env-base-url",
  "description": "DECISIONNODE_BASE_URL is used when no base URL is passed. The runner substitutes {mock_url} with the mock's address.",
  "client": {
    "api_key": "dn_test_conformance",
    "base_url": null
  },
  "env": {
    "DECISIONNODE_BASE_URL": "{mock_url}"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "s",
      "questions": {
        "q": {
          "$truth": {
            "instructions": "?"
          }
        }
      }
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/decide",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body": {
        "model": "decisionnode-moe",
        "state": "s",
        "questions": {
          "q": {
            "type": "truth",
            "instructions": "?"
          }
        }
      }
    }
  }
}
