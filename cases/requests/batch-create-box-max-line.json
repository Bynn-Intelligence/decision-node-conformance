{
  "id": "batch-create-box-max-line",
  "description": "A batch request's max goes in its line as the live call sends it.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "batches.create",
    "args": {
      "requests": [
        {
          "custom_id": "lot-0917",
          "images": [
            {
              "$image": {
                "id": "lot",
                "url": "https://files.example.com/lot/0917.jpg"
              }
            }
          ],
          "questions": {
            "cars": {
              "$box": {
                "instructions": "Every car in the lot.",
                "max": 8
              }
            }
          }
        }
      ]
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/batches",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$"
      },
      "jsonl_count": 1,
      "jsonl_checks": [
        {
          "line": 0,
          "pointer": "/questions",
          "equals": {
            "cars": {
              "type": "box",
              "instructions": "Every car in the lot.",
              "max": 8
            }
          }
        }
      ]
    }
  }
}
