{
  "id": "image-from-url",
  "description": "Image(id, url) sends the id and the URL only.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "",
      "images": [
        {
          "$image": {
            "id": "img",
            "url": "https://example.com/receipt.jpg"
          }
        }
      ],
      "questions": {
        "q": {
          "$truth": {
            "instructions": "Is this a receipt?"
          }
        }
      }
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/decide",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body": {
        "model": "decisionnode-moe",
        "state": "",
        "images": [
          {
            "id": "img",
            "url": "https://example.com/receipt.jpg"
          }
        ],
        "questions": {
          "q": {
            "type": "truth",
            "instructions": "Is this a receipt?"
          }
        }
      }
    }
  }
}
