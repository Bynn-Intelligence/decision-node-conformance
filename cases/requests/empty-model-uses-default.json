{
  "id": "empty-model-uses-default",
  "description": "An explicitly empty model on the client, with DECISIONNODE_MODEL unset, falls back to decisionnode-moe.",
  "client": {
    "api_key": "dn_test_conformance",
    "model": ""
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "s",
      "questions": {
        "q": {
          "$truth": {
            "instructions": "?"
          }
        }
      }
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/decide",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body": {
        "model": "decisionnode-moe",
        "state": "s",
        "questions": {
          "q": {
            "type": "truth",
            "instructions": "?"
          }
        }
      }
    }
  }
}
