{
  "id": "collections-list-items-by-reference-sent",
  "description": "collections.list_items with reference sends it in the query: the items of that reference. (The mock answers this case from its scenario.)",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "collections.list_items",
    "args": {
      "collection_id": "col_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80",
      "reference": "emp-1042"
    }
  },
  "mock": {
    "scenario": {
      "steps": [
        {
          "status": 200,
          "headers": {
            "content-type": "application/json"
          },
          "body": {
            "items": [
