{
  "id": "batch-create-image-uploaded",
  "description": "A batch request's image over the inline threshold is uploaded before the create call, and its line names it by upload_id.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "batches.create",
    "args": {
      "requests": [
        {
          "custom_id": "ticket-1",
          "state": "Receipt attached.",
          "questions": {
            "route": {
              "$choice": {
                "instructions": "Where should this go?",
                "options": [
                  "billing",
                  "bug"
                ]
              }
            },
            "refund": {
              "$truth": {
                "instructions": "Is a refund asked for?"
              }
            }
          },
          "images": [
            {
              "$image": {
                "id": "receipt",
                "path": "fixtures/images/pixel.png",
                "pad_to": 600000
              }
            }
          ]
        }
      ]
    }
  },
  "expect": {
    "requests": [
      {
        "method": "POST",
        "path": "/v1/uploads",
        "headers": {
          "authorization": "Bearer dn_test_conformance"
        },
        "header_patterns": {
          "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
          "content-type": "^application/json(;.*)?$"
        },
        "body": {
          "files": [
            {
              "content_type": "image/png",
              "byte_size": 600000,
              "checksum": "Yj4NtyxKcKkF+lO1i7hnsQ==",
              "sha256": "wv0nNpXCdGFIs+MKEBJQBErTjfCC03p7n6a9D4vyOXQ="
            }
          ]
        }
      },
      {
        "method": "PUT",
        "path_pattern": "^/_mock/s3/uploads/",
        "headers": {
          "content-type": "image/png",
          "content-md5": "Yj4NtyxKcKkF+lO1i7hnsQ==",
          "if-none-match": "*",
          "x-amz-checksum-sha256": "wv0nNpXCdGFIs+MKEBJQBErTjfCC03p7n6a9D4vyOXQ="
        },
        "absent_headers": [
          "authorization",
          "x-mock-session",
          "x-mock-scenario"
        ],
        "body_sha256": "c2fd273695c2746148b3e30a101250044ad38df082d37a7b9fa6bd0f8bf23974"
      },
      {
        "method": "POST",
        "path": "/v1/batches",
        "headers": {
          "authorization": "Bearer dn_test_conformance"
        },
        "header_patterns": {
          "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$"
        },
        "jsonl_count": 1,
        "jsonl_checks": [
          {
            "line": 0,
            "pointer": "/custom_id",
            "equals": "ticket-1"
          },
          {
            "line": 0,
            "pointer": "/images/0/id",
            "equals": "receipt"
          },
          {
            "line": 0,
            "pointer": "/images/0/upload_id",
            "pattern": "^upl_[0-9a-f]{32}$"
          },
          {
            "line": 0,
            "pointer": "/images/0/data",
            "absent": true
          }
        ]
      }
    ]
  }
}
