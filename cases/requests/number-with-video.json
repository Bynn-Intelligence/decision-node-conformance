{
  "id": "number-with-video",
  "description": "number() takes videos like decide(): one number question with the id number beside the video.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "number",
    "args": {
      "state": "s",
      "instructions": "How many forklifts pass the door?",
      "min": 0,
      "max": 50,
      "videos": [
        {
          "$video": {
            "id": "dock",
            "frames": [
              {
                "$frame": {
                  "t": 0,
                  "data_text": "",
                  "media_type": "image/jpeg"
                }
              },
              {
                "$frame": {
                  "t": 0.5,
                  "data_text": "",
                  "media_type": "image/jpeg"
                }
              }
            ]
          }
        }
      ]
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/decide",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body": {
        "model": "decisionnode-moe",
        "state": "s",
        "videos": [
          {
            "id": "dock",
            "frames": [
              {
                "t": 0,
                "media_type": "image/jpeg",
                "data": ""
              },
              {
                "t": 0.5,
                "media_type": "image/jpeg",
                "data": ""
              }
            ]
          }
        ],
        "questions": {
          "number": {
            "type": "number",
            "instructions": "How many forklifts pass the door?",
            "min": 0,
            "max": 50
          }
        }
      }
    }
  }
}
