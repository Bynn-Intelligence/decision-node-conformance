{
  "id": "decide-images-and-videos",
  "description": "An image by URL and two videos in one request: images and videos are separate fields, in the order given, each id unique across both.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "Two cameras at the gate.",
      "images": [
        {
          "$image": {
            "id": "plate",
            "url": "https://files.example.com/plate.jpg"
          }
        }
      ],
      "videos": [
        {
          "$video": {
            "id": "north",
            "frames": [
              {
                "$frame": {
                  "t": 10,
                  "data_text": "",
                  "media_type": "image/jpeg"
                }
              },
              {
                "$frame": {
                  "t": 10.5,
                  "data_text": "",
                  "media_type": "image/jpeg"
                }
              }
            ]
          }
        },
        {
          "$video": {
            "id": "south",
            "frames": [
              {
                "$frame": {
                  "t": 10.25,
                  "data_text": "",
                  "media_type": "image/jpeg"
                }
              }
            ],
            "fps": 4
          }
        }
      ],
      "questions": {
        "q": {
          "$truth": {
            "instructions": "Does the same car pass both cameras?"
          }
        }
      }
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/decide",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body": {
        "model": "decisionnode-moe",
        "state": "Two cameras at the gate.",
        "images": [
          {
            "id": "plate",
            "url": "https://files.example.com/plate.jpg"
          }
        ],
        "videos": [
          {
            "id": "north",
            "frames": [
              {
                "t": 10,
                "media_type": "image/jpeg",
                "data": ""
              },
              {
                "t": 10.5,
                "media_type": "image/jpeg",
                "data": ""
              }
            ]
          },
          {
            "id": "south",
            "fps": 4,
            "frames": [
              {
                "t": 10.25,
                "media_type": "image/jpeg",
                "data": ""
              }
            ]
          }
        ],
        "questions": {
          "q": {
            "type": "truth",
            "instructions": "Does the same car pass both cameras?"
          }
        }
      }
    }
  }
}
