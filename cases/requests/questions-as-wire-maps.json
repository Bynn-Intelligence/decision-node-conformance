{
  "id": "questions-as-wire-maps",
  "description": "Plain maps in the wire form are accepted wherever a builder is, and sent unchanged.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "x",
      "questions": {
        "route": {
          "type": "choice",
          "instructions": "Where should this go?",
          "criteria": {
            "billing": null,
            "bug": {
              "what": "something is broken",
              "not_for": "billing"
            }
          }
        },
        "urgency": {
          "type": "score",
          "criteria": [
            "low",
            "high"
          ]
        },
        "flag": {
          "type": "truth",
          "instructions": "Escalate?",
          "criteria": {
            "true": "yes",
            "false": null
          }
        }
      }
    }
  },
