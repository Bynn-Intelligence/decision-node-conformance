{
  "id": "images-from-paths",
  "description": "Image(id, path) reads the file, base64-encodes it and takes the media type from its first bytes (PNG, JPEG, WebP). Paths are relative to the suite root.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": {
        "claim": {
          "total": "740.00"
        }
      },
      "images": [
        {
          "$image": {
            "id": "receipt",
            "path": "fixtures/images/pixel.png"
          }
        },
        {
          "$image": {
            "id": "photo",
            "path": "fixtures/images/pixel.jpg"
          }
        },
        {
          "$image": {
            "id": "scan",
            "path": "fixtures/images/pixel.webp"
          }
        }
      ],
      "questions": {
        "q": {
          "$truth": {
            "instructions": "Does the receipt total equal the claim?"
          }
        }
      }
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/decide",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body": {
        "model": "decisionnode-moe",
        "state": {
          "claim": {
            "total": "740.00"
          }
        },
        "images": [
          {
            "id": "receipt",
            "media_type": "image/png",
            "data": "iVBORw0KGgoAAAANSUhEUgAAAAIAAAACCAIAAAD91JpzAAAAFklEQVR4nGM8ISfHwMDAxMDAwMDAAAANBAEIfXHKZgAAAABJRU5ErkJggg=="
          },
          {
            "id": "photo",
            "media_type": "image/jpeg",
            "data": ""
          },
          {
            "id": "scan",
            "media_type": "image/webp",
            "data": "UklGRjoAAABXRUJQVlA4IC4AAACwAQCdASoCAAIAAUAmJaACdLoABDAAAP7x3I/4DdfFtMv/vYL/3YL/3YL/WwAA"
          }
        ],
        "questions": {
          "q": {
            "type": "truth",
            "instructions": "Does the receipt total equal the claim?"
          }
        }
      }
    }
  }
}
