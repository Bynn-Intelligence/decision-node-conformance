{
  "id": "number-builder-defaults",
  "description": "number(instructions) with min, max and step left out: they are left out of the wire form, so the server's defaults (0, 255, 1) apply.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "s",
      "questions": {
        "cars": {
          "$number": {
            "instructions": "How many cars are visible?"
          }
        }
      }
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/decide",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body": {
        "model": "decisionnode-moe",
        "state": "s",
        "questions": {
          "cars": {
            "type": "number",
            "instructions": "How many cars are visible?"
          }
        }
      }
    }
  }
}
