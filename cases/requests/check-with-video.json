{
  "id": "check-with-video",
  "description": "The helpers take videos like decide(): check() sends its one question with the id check beside the video.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "check",
    "args": {
      "state": "s",
      "instructions": "Does smoke appear?",
      "videos": [
        {
          "$video": {
            "id": "cam",
            "frames": [
              {
                "$frame": {
                  "t": 0,
                  "data_text": "",
                  "media_type": "image/jpeg"
                }
              }
            ]
          }
        }
      ]
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/decide",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body": {
        "model": "decisionnode-moe",
        "state": "s",
        "videos": [
          {
            "id": "cam",
            "frames": [
              {
                "t": 0,
                "media_type": "image/jpeg",
                "data": ""
              }
            ]
          }
        ],
        "questions": {
          "check": {
            "type": "truth",
            "instructions": "Does smoke appear?"
          }
        }
      }
    }
  }
}
