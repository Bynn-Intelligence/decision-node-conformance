{
  "id": "usage-list-sent",
  "description": "usage.list sends GET /v1/usage with every filter given: each label as label=name:value (sorted by name), each key id as its own key_id, include_empty as true or false. (The mock answers this case from its scenario.)",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "usage.list",
    "args": {
      "start": "2026-09-01T00:00:00Z",
      "end": "2026-10-01T00:00:00Z",
      "labels": {
        "plan": "pro",
        "customer": "acme"
      },
      "device_id": "drone-1",
      "key_ids": [
        "key_00000000000000000000000000000d01",
        "key_00000000000000000000000000000d02"
      ],
      "scope": "decide",
      "status": "active",
      "include_empty": false,
      "limit": 50
    }
  },
  "mock": {
    "scenario": {
      "steps": [
        {
          "status": 200,
          "headers": {
            "content-type": "application/json"
          },
          "body": {
            "period": {
              "start": "2026-09-01T00:00:00Z",
              "end": "2026-10-01T00:00:00Z"
            },
            "as_of": "2026-10-01T00:00:00Z",
            "items": [],
            "next_cursor": null
          }
        }
      ]
    }
  },
  "expect": {
    "request": {
      "method": "GET",
      "path": "/v1/usage",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$"
      },
      "query_all": {
        "start": [
          "2026-09-01T00:00:00Z"
        ],
        "end": [
          "2026-10-01T00:00:00Z"
        ],
        "label": [
          "customer:acme",
          "plan:pro"
        ],
        "device_id": [
          "drone-1"
        ],
        "key_id": [
          "key_00000000000000000000000000000d01",
          "key_00000000000000000000000000000d02"
        ],
        "scope": [
          "decide"
        ],
        "status": [
          "active"
        ],
        "include_empty": [
          "false"
        ],
        "limit": [
          "50"
        ]
      }
    }
  }
}
