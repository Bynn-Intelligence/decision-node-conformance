{
  "id": "image-bytes-webp-detected",
  "description": "Image(id, data) without a media type: the SDK detects WebP from the first bytes and sends it. The case gives the bytes as data_base64 and no media_type; the SDK test decodes them and passes raw bytes only.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "",
      "images": [
        {
          "$image": {
            "id": "img",
            "data_base64": "UklGRjoAAABXRUJQVlA4IC4AAACwAQCdASoCAAIAAUAmJaACdLoABDAAAP7x3I/4DdfFtMv/vYL/3YL/3YL/WwAA"
          }
        }
      ],
      "questions": {
        "q": {
          "$truth": {
            "instructions": "Is the image red?"
          }
        }
      }
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/decide",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body": {
        "model": "decisionnode-moe",
        "state": "",
        "images": [
          {
            "id": "img",
            "media_type": "image/webp",
            "data": "UklGRjoAAABXRUJQVlA4IC4AAACwAQCdASoCAAIAAUAmJaACdLoABDAAAP7x3I/4DdfFtMv/vYL/3YL/3YL/WwAA"
          }
        ],
        "questions": {
          "q": {
            "type": "truth",
            "instructions": "Is the image red?"
          }
        }
      }
    }
  }
}
