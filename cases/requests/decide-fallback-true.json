{
  "id": "decide-fallback-true",
  "description": "fallback=True is sent as \"fallback\": true, as given (the server's default is the same). Left out, the body has no fallback key, as every other request case shows.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "I was charged twice.",
      "questions": {
        "route": {
          "$choice": {
            "instructions": "Where should this go?",
            "options": [
              "billing",
              "bug"
            ]
          }
        }
      },
      "model": "decisionnode-moe",
      "fallback": true
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/decide",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body": {
        "model": "decisionnode-moe",
        "state": "I was charged twice.",
        "questions": {
          "route": {
            "type": "choice",
            "instructions": "Where should this go?",
            "criteria": {
              "billing": null,
              "bug": null
            }
          }
        },
        "fallback": true
      }
    }
  }
}
