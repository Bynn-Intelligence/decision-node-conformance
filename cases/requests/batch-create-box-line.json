{
  "id": "batch-create-box-line",
  "description": "A batch request's point and box questions go in its line as the live call sends them.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "batches.create",
    "args": {
      "requests": [
        {
          "custom_id": "frame-0917",
          "images": [
            {
              "$image": {
                "id": "belt",
                "url": "https://files.example.com/line-3/cam-2/0917.jpg"
              }
            }
          ],
          "questions": {
            "damage": {
              "$box": {
                "instructions": "Draw a box around the damaged package."
              }
            },
            "pick": {
              "$point": {
                "instructions": "Point to the yellow package closest to the robot arm.",
                "units": "normalized"
              }
            }
          }
        }
      ]
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/batches",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$"
      },
      "jsonl_count": 1,
      "jsonl_checks": [
        {
          "line": 0,
          "pointer": "/questions",
          "equals": {
            "damage": {
              "type": "box",
              "instructions": "Draw a box around the damaged package."
            },
            "pick": {
              "type": "point",
              "instructions": "Point to the yellow package closest to the robot arm.",
              "units": "normalized"
            }
          }
        },
        {
          "line": 0,
          "pointer": "/images",
          "equals": [
            {
              "id": "belt",
              "url": "https://files.example.com/line-3/cam-2/0917.jpg"
            }
          ]
        }
      ]
    }
  }
}
