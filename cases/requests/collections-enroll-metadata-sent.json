{
  "id": "collections-enroll-metadata-sent",
  "description": "collections.enroll sends the item's metadata, a flat object, as given beside the reference and the label. (The mock answers this case from its scenario.)",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "collections.enroll",
    "args": {
      "collection_id": "col_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80",
      "image": {
        "$image": {
          "id": "badge",
          "url": "https://files.example.com/badges/emp-1042.jpg"
        }
      },
      "reference": "emp-1042",
      "label": "Reception",
      "metadata": {
        "department": "Reception",
        "badge_level": 2,
        "visitor": false
      }
    }
  },
  "mock": {
    "scenario": {
      "steps": [
        {
          "status": 201,
          "headers": {
            "content-type": "application/json"
          },
          "body": {
            "id": "itm_9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d",
            "collection": "col_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80",
            "reference": "emp-1042",
            "label": "Reception",
            "metadata": {
              "department": "Reception",
              "badge_level": 2,
              "visitor": false
            },
            "faces_found": 1,
            "box": {
              "x1": 412,
              "y1": 220,
              "x2": 580,
              "y2": 470
            },
            "created_at": "2026-10-12T09:00:00Z",
            "usage": {
              "enrollments": 1,
              "cost": {
                "usd": 0.001
              }
            }
          }
        }
      ]
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/collections/col_3f6c1a9e0b2d4c7f8a1e5d9b2c4f6a80/items",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$",
        "idempotency-key": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      },
      "body": {
        "image": {
          "id": "badge",
          "url": "https://files.example.com/badges/emp-1042.jpg"
        },
        "reference": "emp-1042",
        "label": "Reception",
        "metadata": {
          "department": "Reception",
          "badge_level": 2,
          "visitor": false
        }
      }
    }
  }
}
