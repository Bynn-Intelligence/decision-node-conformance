{
  "id": "inline-below-threshold-override",
  "description": "The client's inline_threshold set to 634 bytes and one image of 633 bytes: one byte under the threshold, the image goes inline.",
  "client": {
    "api_key": "dn_test_conformance",
    "inline_threshold": 634
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "s",
      "images": [
        {
          "$image": {
            "id": "photo",
            "path": "fixtures/images/pixel.jpg"
          }
        }
      ],
      "questions": {
        "q": {
          "$truth": {
            "instructions": "Does the receipt total equal the claim?"
          }
        }
      }
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/decide",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body_checks": [
        {
          "pointer": "/model",
          "equals": "decisionnode-moe"
        },
        {
          "pointer": "/state",
          "equals": "s"
        },
        {
          "pointer": "/images/0",
          "equals": {
            "id": "photo",
            "media_type": "image/jpeg",
            "data": ""
          }
        }
      ]
    }
  }
}
