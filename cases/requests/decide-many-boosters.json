{
  "id": "decide-many-boosters",
  "description": "decide_many sends each request's own boosters: the first request names one, the second none and has no boosters key.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide_many",
    "args": {
      "requests": [
        {
          "state": "",
          "images": [
            {
              "$image": {
                "id": "person",
                "url": "https://files.example.com/person.jpg"
              }
            }
          ],
          "questions": {
            "adult": {
              "$truth": {
                "instructions": "Is the person in the first picture an adult?"
              }
            }
          },
          "boosters": [
            "age"
          ]
        },
        {
          "state": "",
          "images": [
            {
              "$image": {
                "id": "poster",
                "url": "https://files.example.com/poster.jpg"
              }
            }
          ],
          "questions": {
            "synthetic": {
              "$truth": {
                "instructions": "Is the second picture AI-generated?"
              }
            }
          }
        }
      ],
      "concurrency": 1
    }
  },
  "expect": {
    "requests": [
      {
        "method": "POST",
        "path": "/v1/decide",
        "headers": {
          "authorization": "Bearer dn_test_conformance"
        },
        "header_patterns": {
          "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
          "content-type": "^application/json(;.*)?$"
        },
        "body": {
          "model": "decisionnode-moe",
          "state": "",
          "images": [
            {
              "id": "person",
              "url": "https://files.example.com/person.jpg"
            }
          ],
          "questions": {
            "adult": {
              "type": "truth",
              "instructions": "Is the person in the first picture an adult?"
            }
          },
          "boosters": [
            "age"
          ]
        }
      },
      {
        "method": "POST",
        "path": "/v1/decide",
        "headers": {
          "authorization": "Bearer dn_test_conformance"
        },
        "header_patterns": {
          "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
          "content-type": "^application/json(;.*)?$"
        },
        "body": {
          "model": "decisionnode-moe",
          "state": "",
          "images": [
            {
              "id": "poster",
              "url": "https://files.example.com/poster.jpg"
            }
          ],
          "questions": {
            "synthetic": {
              "type": "truth",
              "instructions": "Is the second picture AI-generated?"
            }
          }
        }
      }
    ]
  }
}
