{
  "id": "check-with-boosters",
  "description": "The helpers take boosters like decide: check sends its one question with the boosters beside it.",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "check",
    "args": {
      "state": "",
      "instructions": "Is the person in the first picture an adult?",
      "images": [
        {
          "$image": {
            "id": "person",
            "url": "https://files.example.com/person.jpg"
          }
        }
      ],
      "boosters": [
        "age"
      ]
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/decide",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body": {
        "model": "decisionnode-moe",
        "state": "",
        "images": [
          {
            "id": "person",
            "url": "https://files.example.com/person.jpg"
          }
        ],
        "questions": {
          "check": {
            "type": "truth",
            "instructions": "Is the person in the first picture an adult?"
          }
        },
        "boosters": [
          "age"
        ]
      }
    }
  }
}
