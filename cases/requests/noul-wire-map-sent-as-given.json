{
  "id": "noul-wire-map-sent-as-given",
  "description": "A question given as a wire map of type noul on decide is sent as given: the SDK does not rename it (truth is what its builders write).",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "s",
      "questions": {
        "q": {
          "type": "noul",
          "instructions": "Escalate?"
        }
      }
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/decide",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body": {
        "model": "decisionnode-moe",
        "state": "s",
        "questions": {
          "q": {
            "type": "noul",
            "instructions": "Escalate?"
          }
        }
      }
    }
  }
}
