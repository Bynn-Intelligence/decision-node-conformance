{
  "id": "empty-model-per-call-uses-client",
  "description": "An explicitly empty model on a call counts as not given: the client's model applies.",
  "client": {
    "api_key": "dn_test_conformance",
    "model": "decisionnode-moe"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "s",
      "questions": {
        "q": {
          "$truth": {
            "instructions": "?"
          }
        }
      },
      "model": ""
    }
  },
  "expect": {
    "request": {
      "method": "POST",
      "path": "/v1/decide",
      "headers": {
        "authorization": "Bearer dn_test_conformance"
      },
      "header_patterns": {
        "user-agent": "^decisionnode-(python|node|go|java|dotnet|ruby|php|rust)/[0-9A-Za-z.+_-]+$",
        "content-type": "^application/json(;.*)?$"
      },
      "body": {
        "model": "decisionnode-moe",
        "state": "s",
        "questions": {
          "q": {
            "type": "truth",
            "instructions": "?"
          }
        }
      }
    }
  }
}
