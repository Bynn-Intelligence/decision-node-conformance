{
  "id": "decide-booster-segment-options-sent",
  "description": "Segment Vision's options are sent in the object form as given, in the caller's order: prompt (one phrase as a string, or an array of 1 to 4 phrases of at most 120 characters, required), max_instances, min_score, polygon_points and depth. The SDK checks nothing about them locally and never cleans the phrases; the rules are the API's. (The mock answers this case from its scenario.)",
  "client": {
    "api_key": "dn_test_conformance"
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "",
      "images": [
        {
          "$image": {
            "id": "gate",
            "url": "https://files.example.com/drone/gate-3.jpg"
          }
        }
      ],
      "questions": {
        "gate_ahead": {
          "$truth": {
            "instructions": "Is the drone lined up with the gate's opening?"
          }
        }
      },
      "boosters": [
        {
          "$booster": {
            "name": "bynn_segment",
            "images": [
              "gate"
            ],
            "options": {
              "prompt": [
                "purple gate",
                "landing pad"
              ],
              "max_instances": 4,
              "min_score": 0.3,
              "polygon_points": 4,
              "depth": false
            }
          }
        }
      ]
    }
  },
  "mock": {
