{
  "id": "403-refusal-with-boosters",
  "description": "A refusal of a request that named boosters is still a RefusalError, and carries the boosters that ran (the refused request pays nothing for them).",
  "client": {
    "api_key": "dn_test_conformance",
    "max_retries": 0
  },
  "call": {
    "method": "decide",
    "args": {
      "state": "",
      "images": [
        {
          "$image": {
            "id": "person",
            "url": "https://files.example.com/person.jpg"
          }
        }
      ],
      "questions": {
        "adult": {
          "$truth": {
            "instructions": "Is the person in the first picture an adult?"
          }
        }
      },
      "boosters": [
        "age"
      ]
    }
  },
  "response": {
    "status": 403,
    "headers": {
      "content-type": "application/json",
      "x-request-id": "req_err_0001",
      "x-decisionnode-refusal": "harm",
      "x-decisionnode-safety": "harm=0.964;blocked, self_harm=0.002",
      "x-decisionnode-boosters": "age=ok:212"
    },
    "body_text": "{\"detail\": {\"error_type\": \"refusal_error\", \"message\": \"This request was refused under the usage policy: it asks to choose, rank or target people to be harmed.\", \"category\": \"harm\"}}"
  },
  "expect": {
    "error": {
      "class": "RefusalError",
      "fields": {
        "status": 403,
        "error_type": "refusal_error",
        "message": "This request was refused under the usage policy: it asks to choose, rank or target people to be harmed.",
        "category": "harm",
        "safety": {
          "checked": true,
          "harm": 0.964,
          "self_harm": 0.002,
          "flagged": [
            "harm"
          ]
        },
        "boosters": {
          "age": {
            "status": "ok",
            "latency_ms": 212
          }
        },
        "request_id": "req_err_0001"
      }
    }
  }
}
