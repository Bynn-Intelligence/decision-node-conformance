{
  "id": "413-batch-add-too-large",
  "description": "batches.add answered 413 request_too_large_error: RequestTooLargeError with status and error_type. Batch errors use the classes by status, and from 1.11 every 413 is a RequestTooLargeError.",
  "client": {
    "api_key": "dn_test_conformance",
    "max_retries": 0
  },
  "call": {
    "method": "batches.add",
    "args": {
      "batch_id": "batch_01J9ZB8Q3T",
      "requests": [
        {
          "custom_id": "a",
          "state": "x",
          "questions": {
            "route": {
              "$choice": {
                "instructions": "Where should this go?",
                "options": [
                  "billing",
                  "bug"
                ]
              }
            },
            "refund": {
              "$truth": {
                "instructions": "Is a refund asked for?"
              }
            }
          }
        }
      ]
    }
  },
  "response": {
    "status": 413,
    "headers": {
      "content-type": "application/json",
      "x-request-id": "req_case_0001",
      "x-decisionnode-error": "The call is over 10485760 bytes."
    },
    "body_text": "{\"detail\": {\"error_type\": \"request_too_large_error\", \"message\": \"The call is over 10485760 bytes.\"}}"
  },
  "expect": {
    "error": {
      "class": "RequestTooLargeError",
      "fields": {
        "status": 413,
        "error_type": "request_too_large_error",
        "message": "The call is over 10485760 bytes."
      }
    }
  }
}
