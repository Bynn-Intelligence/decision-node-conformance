    "body_text": "{\"detail\": [{\"type\": \"missing\", \"loc\": [\"body\", \"questions\", \"urgency\", \"score\", \"criteria\"], \"msg\": \"Field required\", \"input\": {\"type\": \"score\", \"instructions\": \"How urgent?\"}}]}"
