  "client": {
    "api_key": "dn_test_conformance",
    "max_retries": 0
  },
  "call": {
    "method": "decide_raw",
    "args": {
      "body": {
        "model": "decisionnode-moe",
        "state": "s",
        "questions": {
          "urgency": {
            "type": "score",
            "instructions": "How urgent?"
          }
        }
      }
    }
  },
  "response": {
    "status": 422,
    "headers": {
      "content-type": "application/json",
